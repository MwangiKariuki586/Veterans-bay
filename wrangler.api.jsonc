{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "veterans-bay-api",
  "main": "src/workers/api/index.ts",
  "compatibility_date": "2026-07-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "APP_ENV": "development",
    "WEB_ORIGIN": "http://localhost:3000"
  },
  "queues": {
    "producers": [
      {
        "binding": "DOMAIN_EVENTS_QUEUE",
        "queue": "veterans-bay-domain-events"
      }
    ],
    "consumers": [
      {
        "queue": "veterans-bay-domain-events",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5
      }
    ]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 600,
        "period": 60
      }
    },
    {
      "name": "PUBLIC_SUBMISSION_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "dev": {
    "port": 8787
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "preview": {
      "name": "veterans-bay-api-preview",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "APP_ENV": "preview",
        "BETTER_AUTH_URL": "https://veterans-bay-web-preview.mwangialex268.workers.dev",
        "WEB_ORIGIN": "https://veterans-bay-web-preview.mwangialex268.workers.dev"
      },
      "queues": {
        "producers": [
          {
            "binding": "DOMAIN_EVENTS_QUEUE",
            "queue": "veterans-bay-domain-events-preview"
          }
        ],
        "consumers": [
          {
            "queue": "veterans-bay-domain-events-preview",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5
          }
        ]
      },
      "ratelimits": [
        {
          "name": "API_RATE_LIMITER",
          "namespace_id": "2001",
          "simple": {
            "limit": 600,
            "period": 60
          }
        },
        {
          "name": "PUBLIC_SUBMISSION_RATE_LIMITER",
          "namespace_id": "2002",
          "simple": {
            "limit": 30,
            "period": 60
          }
        }
      ]
    },
    "production": {
      "name": "veterans-bay-api-production",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "APP_ENV": "production",
        "BETTER_AUTH_URL": "https://veterans-bay-web-production.mwangialex268.workers.dev",
        "WEB_ORIGIN": "https://veterans-bay-web-production.mwangialex268.workers.dev"
      },
      "queues": {
        "producers": [
          {
            "binding": "DOMAIN_EVENTS_QUEUE",
            "queue": "veterans-bay-domain-events-production"
          }
        ],
        "consumers": [
          {
            "queue": "veterans-bay-domain-events-production",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5
          }
        ]
      },
      "ratelimits": [
        {
          "name": "API_RATE_LIMITER",
          "namespace_id": "3001",
          "simple": {
            "limit": 600,
            "period": 60
          }
        },
        {
          "name": "PUBLIC_SUBMISSION_RATE_LIMITER",
          "namespace_id": "3002",
          "simple": {
            "limit": 30,
            "period": 60
          }
        }
      ]
    }
  }
}
