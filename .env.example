# Runtime (server / Worker only)
APP_ENV=development

# Browser → API Worker CORS origin
WEB_ORIGIN=http://localhost:3000

# Next.js rewrite target for /api/*
API_ORIGIN=http://127.0.0.1:8787

# Database (Neon PostgreSQL) — also copy into .dev.vars for Wrangler
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Identity (Better Auth) — server-only; also copy into .dev.vars
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# BETTER_AUTH_URL must match the browser origin that serves /api/auth
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000

# File storage (Cloudinary) — server-only; also copy into .dev.vars
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Queue / Cron bindings are configured in wrangler.api.jsonc (DOMAIN_EVENTS_QUEUE).
# Rate limits: API_RATE_LIMITER and PUBLIC_SUBMISSION_RATE_LIMITER are Worker bindings.
