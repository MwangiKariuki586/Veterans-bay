{
  "name": "veterans-bay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Veterans Bay service marketplace and professional operations platform.",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.3",
  "scripts": {
    "preinstall": "node scripts/check-runtime.mjs",
    "runtime:check": "node scripts/check-runtime.mjs",
    "dev": "concurrently --kill-others-on-fail --names web,api \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "next dev",
    "dev:api": "wrangler dev --config wrangler.api.jsonc",
    "build": "next build --webpack",
    "build:api": "wrangler deploy --dry-run --config wrangler.api.jsonc --outdir .wrangler/api-build",
    "build:all": "npm run build && npm run build:api",
    "start": "next start",
    "preview:web": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "preview:api": "wrangler dev --config wrangler.api.jsonc",
    "cf:typegen": "wrangler types --config wrangler.api.jsonc worker-configuration.d.ts",
    "cf:typecheck": "wrangler types --config wrangler.api.jsonc worker-configuration.d.ts --check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "db:seed:preview-uat": "node scripts/seed-preview-uat.mjs --confirm-preview",
    "db:verify:preview-uat": "node scripts/seed-preview-uat.mjs --verify",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.worker.config.ts && vitest run --config vitest.database.config.ts",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test e2e/accessibility.spec.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "verify": "npm run runtime:check && npm run cf:typecheck && npm run typecheck && npm run lint && npm run test && npm run build:all",
    "verify:phase-00": "npm run verify"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-label": "2.1.11",
    "@radix-ui/react-slot": "1.3.0",
    "@radix-ui/react-tooltip": "1.2.12",
    "better-auth": "1.6.23",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.30",
    "lucide-react": "1.24.0",
    "next": "^16.2.12",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-icons": "^5.5.0",
    "sharp": "0.35.3",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@opennextjs/cloudflare": "^1.20.2",
    "@playwright/test": "^1.55.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "concurrently": "^10.0.4",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "wrangler": "^4.114.0",
    "ws": "8.21.1"
  },
  "overrides": {
    "postcss": "8.5.19",
    "sharp": "0.35.3"
  }
}
